# /etc/morning-brief/env  (chmod 600, read by the three systemd units)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
# your internal API (read-only token) and the webhook in front of your Claude setup.
# CLAUDE_WEBHOOK_URL points at the machine that runs claude_webhook/server.py: this server if you
# enable morning-brief-webhook here, otherwise your Claude host. WEBHOOK_SECRET must match on both.
INTERNAL_API_URL=http://127.0.0.1:8301
INTERNAL_API_TOKEN=demo-read-only-token
CLAUDE_WEBHOOK_URL=http://127.0.0.1:8302
WEBHOOK_SECRET=change-me
# the call page listens here; put it behind your reverse proxy with HTTPS for phones.
# Every call costs model minutes: with CALL_PAGE_KEY set, the page only opens calls when its URL
# carries ?key=THE_KEY. Without it, only this machine can start calls. TOKENS_PER_HOUR caps calls per address.
WEB_HOST=127.0.0.1
CALL_PAGE_KEY=
TOKENS_PER_HOUR=20
